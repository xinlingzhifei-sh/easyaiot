# yFeiEye Sentinel Agent（集群节点观察者）
#
# 部署在**计算/媒体/GPU 节点**，职责：
# - 组件探测（ComponentSentinel）
# - 可调度性快照上报 NODE 控制面
# - 执行 NODE 调度下发的工作负载
# - （Phase 2）缺组件自动拉取/自愈
#
# 控制面汇总与调度见顶级模块 NODE/（iot-node）

# 节点 ID（在 WEB 后台创建节点后获得）
NODE_ID=1
# Agent 令牌（创建节点时返回，或通过「重置令牌」获取）
AGENT_TOKEN=your-agent-token-here
# 控制面宿主机 Sentinel 设为 1，启动时从 bootstrap 同步凭据（数据库重建后自动修复 nodeId）
# 远程计算节点部署时由平台写入 PLATFORM_AGENT=0，请勿改为 1
# PLATFORM_AGENT=1
# 仅控制面宿主机 Sentinel 使用；须与 iot-node 的 EASYAIOT_PLATFORM_AGENT_BOOTSTRAP_TOKEN 一致
PLATFORM_AGENT_BOOTSTRAP_TOKEN=
# 控制面地址（经 Gateway）— 上报至 NODE 控制面
CONTROL_PLANE_URL=http://localhost:48080/admin-api/node/agent
HEARTBEAT_INTERVAL=10
COMMAND_POLL_ENABLED=true
COMMAND_POLL_INTERVAL=3
COMMAND_POLL_MAX_COMMANDS=5
# 监听地址，可写多个（逗号分隔）；收紧时写 <内网IP>,127.0.0.1——控制面经该内网地址下发指令，
# 部署校验经 SSH 在本机探测 127.0.0.1。注意 iot-node 重新部署会把本文件重写回 0.0.0.0
AGENT_LISTEN_HOST=0.0.0.0
AGENT_LISTEN_PORT=9100
# HTTP 服务（waitress）工作线程数；摄像头网段扫描单次可达 330s
# AGENT_HTTP_THREADS=16
# 来源白名单（IP 或 CIDR，逗号分隔），为空不限制；填写时须包含控制面（iot-node）出口地址。
# 回环地址始终放行；条目全部写错时只放行回环地址，控制面会连不上
# AGENT_ALLOWED_SOURCES=10.0.0.0/24
# 鉴权失败限速：同一来源 AGENT_AUTH_FAIL_WINDOW 秒内失败 AGENT_AUTH_FAIL_LIMIT 次后，
# 封禁 AGENT_AUTH_BLOCK_SECONDS 秒（期间返回 429）；回环地址不限，LIMIT=0 关闭
# AGENT_AUTH_FAIL_LIMIT=20
# AGENT_AUTH_FAIL_WINDOW=60
# AGENT_AUTH_BLOCK_SECONDS=300
# 摄像头网段扫描并发上限，超出时返回 429；0 表示不限
# AGENT_CAMERA_SCAN_CONCURRENCY=2
# 节点 Profile（功能 CSV，与控制面勾选一致）
NODE_FUNCTIONS=algorithm,forward,live
# L1 周期扫描（秒）与缺组件自愈
# SENTINEL_L1_INTERVAL=300
# SENTINEL_AUTO_REMEDIATE=true
# SENTINEL_HEAL_MAX_ATTEMPTS=3
# SENTINEL_HEAL_TIMEOUT=600
AI_ROOT=/opt/easyaiot/AI
VIDEO_ROOT=/opt/easyaiot/VIDEO
MEDIA_CLUSTER_ROOT=/opt/easyaiot/media-cluster
MQTT_CLUSTER_ROOT=/opt/easyaiot/mqtt-cluster
# WebRTC 公网 NAT 配置：公网播放时用于 SRS candidate / ZLM externIP 和前端 ICE 配置
WEBRTC_PUBLIC_IP=
ZLM_RTC_EXTERN_IP=
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_FORCE_SECURE=true
WEBRTC_PREFER_WSS=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
