# ============================================
# VIDEO服务环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp env.example .env
# 2. 根据实际情况修改各个配置项
# 3. 注意：.env 文件包含敏感信息，不要提交到版本控制系统
# ============================================

# ============================================
# Flask应用配置
# ============================================
# Flask密钥（用于会话加密，请使用强随机字符串）
SECRET_KEY=

# SRS HTTP Hook shared token. Production requires at least 32 bytes.
# Keep the same value in .scripts/docker/.env.docker; never expose it through nginx.
YFEIEYE_SRS_HOOK_TOKEN=

# Flask运行端口（默认6000）
FLASK_RUN_PORT=6000

# Flask运行主机（生产环境绑定 Docker bridge 网关）
FLASK_RUN_HOST=172.17.0.1

# Flask调试模式（生产环境建议设置为False）
DEBUG=False

# 允许的主机列表
ALLOWED_HOSTS=172.17.0.1,localhost,127.0.0.1,host.docker.internal,video-host

# ============================================
# 数据库配置
# ============================================
# PostgreSQL数据库连接URL
# 格式: postgresql://用户名:密码@主机:端口/数据库名
# 注意：如果使用postgres://开头，代码会自动转换为postgresql://
# 在Docker环境中，使用容器服务名称：PostgresSQL（参考install_middleware_linux.sh）
# 数据库名：iot-video20（由中间件安装脚本创建）
DATABASE_URL=

# ============================================
# Nacos服务注册与发现配置
# ============================================
# Nacos服务器地址（格式：IP:端口 或 服务名称:端口）
# 在Docker环境中，使用容器服务名称：Nacos（参考install_middleware_linux.sh）
NACOS_SERVER=Nacos:8848

# Nacos命名空间（默认：空字符串，使用默认命名空间public）
NACOS_NAMESPACE=

# Nacos用户名（默认：nacos）
NACOS_USERNAME=nacos

# Nacos密码
NACOS_PASSWORD=CHANGE_ME

# 服务名称（用于Nacos注册）
SERVICE_NAME=video-server

# Pod IP地址（可选，如果不设置会自动获取）
# 在Docker容器中运行时，建议设置为容器的IP地址
POD_IP=

# ============================================
# MinIO对象存储配置
# ============================================
# MinIO服务器地址（格式：IP:端口 或 服务名称:端口）
# 在Docker环境中，使用容器服务名称：MinIO（参考install_middleware_linux.sh）
MINIO_ENDPOINT=MinIO:9000

# MinIO访问密钥
MINIO_ACCESS_KEY=

# MinIO密钥（由中间件安装脚本设置）
MINIO_SECRET_KEY=

# MinIO是否使用HTTPS（true/false）
MINIO_SECURE=false

# ============================================
# 视频服务特有配置
# ============================================
# 模型推流地址（RTMP服务器地址）
MODEL_AI_PUSH_URL=pro.basiclab.top:1935

# 摄像头存活检测时间间隔（秒）
CAMERA_ONLINE_INTERVAL=10

# AI 后处理 Worker（默认不启动；需要时 EASYAIOT_ENABLE_POST_PROCESS_WORKER=1）
# EASYAIOT_ENABLE_POST_PROCESS_WORKER=0
# VIDEO 与 iot-sink 必须配置相同的独立服务令牌（至少 32 字节）
IOT_SINK_POST_PROCESS_TOKEN=
# VIDEO 与 iot-message 必须配置相同的独立服务令牌（至少 32 字节）
IOT_MESSAGE_INTERNAL_TOKEN=
# VIDEO 调用 GB28181 内部点播接口使用的平台 RPC 令牌；由部署脚本从全局环境同步。
IOT_RPC_INTERNAL_TOKEN=
# GB28181_RPC_SERVICE_URL=http://127.0.0.1:48088/rpc-api/gb28181

# 同网段 WS-Discovery 与按 MAC 刷新设备 IP 不再由后台定时任务执行；需要时请在前端点「更新 ONVIF 设备」
# 或调用 POST /video/camera/refresh。已移除跨网段网段扫描（原 CAMERA_DISCOVER_CIDRS 等配置）。

# ONVIF WSDL目录（可选）
# ONVIF_WSDL_DIR=/etc/onvif/wsdl

# ============================================
# 实时算法服务队列配置（可选，用于优化高负载场景）
# ============================================
# 检测队列大小（默认100，原50，增大可减少队列满的错误）
# 如果遇到"检测队列已满"警告，可以适当增大此值
DETECTION_QUEUE_SIZE=100

# 推帧队列大小（默认100，原50，增大可减少队列满的错误）
# 如果遇到"推帧队列已满"警告，可以适当增大此值
PUSH_QUEUE_SIZE=100

# 抽帧队列大小（默认50）
EXTRACT_QUEUE_SIZE=50

# YOLO检测工作线程数量（默认2，原1，增大可提升处理能力）
# 如果检测速度跟不上，可以适当增加此值（建议2-4个）
# 注意：线程数过多可能增加CPU占用
YOLO_WORKER_THREADS=2

# ============================================
# 实时算法服务视频处理配置（可选，用于优化CPU占用和推流速度）
# ============================================
# 视频帧率（默认25fps，保证实时运动画面流畅）
SOURCE_FPS=25

# 视频分辨率宽度（默认1280）
TARGET_WIDTH=1280

# 视频分辨率高度（默认720）
TARGET_HEIGHT=720

# 抽帧间隔（默认5，表示每5帧抽取一帧进行检测）
EXTRACT_INTERVAL=5

# 帧缓存大小（默认70）
BUFFER_SIZE=70

# 最小缓存帧数（默认15）
MIN_BUFFER_FRAMES=15

# 最大等待时间（秒，默认0.08）
MAX_WAIT_TIME=0.08

# YOLO检测分辨率（默认640，保留小目标检测精度）
YOLO_IMG_SIZE=640

# ============================================
# FFmpeg编码配置（可选，用于优化CPU占用和推流速度）
# ============================================
# RTSP 拉流传输（部署时请写入 VIDEO/.env，与算法/stream_forward/camera 预览一致；显式 tcp 推荐）
# AI_RTSP_TRANSPORT=tcp
# FFMPEG_RTSP_TRANSPORT=tcp
# OPENCV_FFMPEG_RTSP_TRANSPORT=tcp
# VIEW_FFMPEG_RTSP_TRANSPORT=tcp
#
# GB28181 播放优先使用 fMP4，失败时由服务回退其他协议
GB28181_PLAY_PROTOCOL=fmp4_first
#
# FFmpeg编码预设（默认veryfast，平衡画质、码率与CPU占用）
# 可选值：ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
# 注意：预设越快，CPU占用越低，但压缩率也越低
FFMPEG_PRESET=veryfast

# FFmpeg视频比特率（默认3500k，适配720p实时画面）
# 格式：数字+k（如500k）或数字（如500000）
FFMPEG_VIDEO_BITRATE=3500k

# FFmpeg编码线程数（默认不设置，表示自动）
# 如果CPU占用过高，可以设置为较小值（如2或4）来限制线程数
# 注意：设置为空字符串或不设置表示自动
FFMPEG_THREADS=

# FFmpeg GOP大小（关键帧间隔，默认50，即25fps下每2秒一个关键帧）
FFMPEG_GOP_SIZE=50

# ============================================
# 其他配置
# ============================================
# Python输出不缓冲（建议设置为1）
PYTHONUNBUFFERED=1

# 时区设置
TZ=Asia/Shanghai

# ============================================
# Redis配置（可选，如果需要）
# ============================================
# Redis服务器地址（在Docker环境中，使用容器服务名称：Redis，参考install_middleware_linux.sh）
# REDIS_HOST=Redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# Kafka配置（可选，如果需要）
# ============================================
# Kafka服务器地址
# 注意：VIDEO服务使用host网络模式，必须使用宿主机IP或localhost，不能使用容器名
# 如果Kafka运行在宿主机上，VIDEO(host网络)应使用 EXTERNAL listener：localhost:9094
# 如果Kafka运行在其他机器上，使用：<宿主机IP>:9094
# 支持多个服务器，用逗号分隔，例如：192.168.1.100:9094,192.168.1.101:9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Kafka告警主题名称（实时算法任务使用）
KAFKA_ALERT_TOPIC=iot-alert-notification

# IoT 业务主题建议 64 分区（install_middleware_linux.sh init_kafka_iot_topics 或 docker-compose KAFKA_NUM_PARTITIONS）
# 含：iot-alert-*、iot-snapshot-alert*、iot-face-matching*、iot-plate-matching*
# 已有环境扩容示例:
# docker exec kafka-server /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --alter --topic iot-face-matching --partitions 64

# Kafka告警通知主题名称（实时算法任务使用，与KAFKA_ALERT_TOPIC相同）
KAFKA_ALERT_NOTIFICATION_TOPIC=iot-alert-notification

# Kafka抓拍算法任务告警主题名称（抓拍算法任务使用，区别于实时算法任务）
KAFKA_SNAPSHOT_ALERT_TOPIC=iot-snapshot-alert

# 人脸匹配 Kafka 主题（算法任务裁剪人脸后异步投递，iot-sink 集群消费）
KAFKA_FACE_MATCHING_TOPIC=iot-face-matching
KAFKA_FACE_MATCHING_RESULT_TOPIC=iot-face-matching-result
KAFKA_PLATE_MATCHING_TOPIC=iot-plate-matching
KAFKA_PLATE_MATCHING_RESULT_TOPIC=iot-plate-matching-result

# 固定人脸模型（位于 VIDEO 根目录，见 app/utils/face_model_paths.py）
# face_det.onnx  — 人脸/头部抓取（YOLO）
# face_rec.onnx  — 人脸 1:N 匹配特征提取（ArcFace ONNX，约 167MB，登录 WEB 人脸库页下载）
# FACE_REC_MODEL_DOWNLOAD_URL=https://github.com/deepinsight/insightface/releases/download/v0.7/buffalo_l.zip
# FACE_CAPTURE_MODEL_PATH=./face_det.onnx
# FACE_MATCH_MODEL_PATH=./face_rec.onnx
FACE_CAPTURE_CONF_THRESHOLD=0.45
FACE_CAPTURE_IOU_THRESHOLD=0.5
# 人脸抓取独立队列（与主算法检测解耦，避免拖慢 overlay/alert/YOLO）
FACE_CAPTURE_QUEUE_SIZE=8
FACE_CAPTURE_WORKER_THREADS=1
FACE_CAPTURE_KEEP_LATEST=true
FACE_CAPTURE_KEEP_LATEST_THRESHOLD=4

# Kafka请求超时时间（毫秒，默认30000，即30秒）
# 增加超时时间可以提高连接稳定性，避免频繁断开
KAFKA_REQUEST_TIMEOUT_MS=30000

# Kafka重试次数（默认3）
# 增加重试次数可以提高消息发送成功率
KAFKA_RETRIES=3

# Kafka重试间隔（毫秒，默认1000，即1秒）
# 增加重试间隔可以避免频繁重试导致的问题
KAFKA_RETRY_BACKOFF_MS=1000

# Kafka元数据最大年龄（毫秒，默认300000，即5分钟）
KAFKA_METADATA_MAX_AGE_MS=300000

# Kafka连接建立超时（毫秒，默认10000，即10秒）
# 用于控制建立连接时的超时时间
KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000

# Kafka最大阻塞时间（毫秒，默认60000，即60秒）
# 用于控制send等操作的阻塞时间
KAFKA_MAX_BLOCK_MS=60000

# Kafka消息传递超时（毫秒，默认120000，即120秒）
# 用于控制消息从发送到确认的超时时间
KAFKA_DELIVERY_TIMEOUT_MS=120000

# Kafka初始化失败后重试间隔（秒，默认60）
KAFKA_INIT_RETRY_INTERVAL=60

# ============================================
# Milvus 向量数据库配置（人脸管理/识别）
# ============================================
# 优先使用远程 Milvus（Docker 默认 localhost:19530）
# 若留空将自动回退为本地 Milvus Lite 文件
MILVUS_URI=http://localhost:19530
# 人脸向量集合名称
FACE_MILVUS_COLLECTION=face_embeddings
# 人脸匹配阈值（越大越严格，建议 0.50~0.70）
FACE_SIMILARITY_THRESHOLD=0.55

# ============================================
# TDengine配置（可选，如果需要）
# ============================================
# TDengine服务器地址（在Docker环境中，使用容器服务名称：TDengine，参考install_middleware_linux.sh）
# TDENGINE_HOST=TDengine
# TDENGINE_PORT=6030

# ============================================
# 阿里云百炼平台配置（用于 QwenVL3 视觉推理）
# ============================================
# DashScope API Key（阿里云百炼平台的 API 密钥）
# 获取方式：登录阿里云百炼控制台 -> API-KEY 管理 -> 创建新的 API Key
# 文档：https://bailian.console.aliyun.com/?spm=5176.29597918.J_C-NDPSQ8SFKWB4aef8i6I.4.298d7b08IRr02o&tab=doc#/doc/?type=model&url=2877996
# 配置后可使用 configure_qwenvl3_api_key.py 脚本自动配置到数据库
DASHSCOPE_API_KEY=

# ============================================
# 代理配置（可选，如果需要）
# ============================================
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ============================================
# 部署形态与 Java 后端（mini 形态直连 iot-system:48099）
# ============================================
# EASYAIOT_DEPLOY_PROFILE=mini   # mini | standard | full
# JAVA_BACKEND_URL=http://localhost:48099
# GATEWAY_URL=http://localhost:48099
# 可选：消息服务数据库后备查询；未配置时仅使用 HTTP API
# MESSAGE_DATABASE_URL=
# AUTH_CHECK_URL=http://localhost:48099/admin-api/system/auth/get-permission-info
# YFEIEYE_MEDIA_AUTHORIZATION_URL=http://localhost:48099/admin-api/system/auth/media-permission-check
# Production with multiple callers requires a distinct >=32-byte key per
# service. The legacy shared secret is accepted only for a single service.
# YFEIEYE_MEDIA_SERVICE_HMAC_KEYS={"iot-system":"iot-system-secret-at-least-32-bytes","video-algorithm":"video-algorithm-secret-at-least-32-bytes"}
# YFEIEYE_MEDIA_SERVICE_POLICIES={"iot-system":{"actions":["coverage","export","download","playback","manifest_verify"],"cameraIds":["camera-01","camera-02"],"allowOnBehalf":true},"video-algorithm":{"actions":["alert_ingest"],"cameraIds":["camera-01","camera-02"],"allowOnBehalf":false}}
# YFEIEYE_MEDIA_SERVICE_HMAC_SECRET=single-service-legacy-secret-at-least-32-bytes
# YFEIEYE_MEDIA_SERVICE_IDS=iot-system,video-algorithm
# YFEIEYE_MEDIA_SERVICE_ALLOWED_ACTIONS=coverage,export,download,playback,manifest_verify
# Production must enumerate real camera IDs. Do not use an unbounded wildcard.
# YFEIEYE_MEDIA_SERVICE_ALLOWED_CAMERA_IDS=camera-01,camera-02
# Signed browser playback tickets remain reusable for Range requests only within this window (max 300 seconds).
# YFEIEYE_MEDIA_SERVICE_MAX_SKEW_SECONDS=300
# YFEIEYE_MEDIA_ACCESS_AUDIT_DIR=/data/yfeieye-record-exports/access-audit
# YFEIEYE_MEDIA_ACCESS_AUDIT_MAX_BYTES=67108864
# YFEIEYE_MEDIA_ACCESS_AUDIT_BACKUP_COUNT=5
# Comma-separated absolute roots. Only canonical regular files below these roots
# can be read as local alert/record/export media.
# YFEIEYE_LOCAL_MEDIA_ROOTS=/app/alert_images,/data/playbacks,/data/yfeieye-record-exports
# VIDEO_ENV=development
# YFEIEYE_ALERT_INGEST_SERVICE_ID=video-algorithm
# YFEIEYE_ALERT_INGEST_TENANT_ID=1
# YFEIEYE_SNAPSHOT_TENANT_ID=1
# YFEIEYE_ALERT_INGEST_ALLOW_UNSIGNED=true
# The unsigned switch is honored only when VIDEO_ENV is development/dev/test/local.
# Required for DVR/record-space object storage. New objects are written under
# tenants/{tenantId}/...; production currently uses tenant 1. Empty values fail closed.
# YFEIEYE_DVR_TENANT_ID=1
# Required by the immutable tenant migration. Only tenant 1 may own historical
# non-prefixed record/snapshot object keys; missing or other values fail closed.
# YFEIEYE_VIDEO_LEGACY_TENANT_ID=1
# Production/release must configure an active HMAC key. Development/test may opt in
# to the non-HMAC fallback explicitly; never enable this in production.
# Every HMAC secret must contain at least 32 UTF-8 bytes.
# YFEIEYE_RECORD_EXPORT_HMAC_KEYS={"activeKeyId":"2026-q3","keys":{"2026-q2":"previous-secret-at-least-32-bytes","2026-q3":"current-secret-at-least-32-bytes"}}
# A non-empty malformed keyring is fatal and never falls back to the legacy secret.
# YFEIEYE_RECORD_EXPORT_ACTIVE_KEY_ID=2026-q3
# YFEIEYE_RECORD_EXPORT_ALLOW_SHA256_FALLBACK=true
# YFEIEYE_RECORD_EXPORT_STORE_DIR=/data/yfeieye-record-exports
# Keep the retained store, temporary workspace, and seekable cache below the
# host volume capacity. The process also preserves the configured free-space
# reserve before and while ffmpeg is running.
# YFEIEYE_RECORD_EXPORT_STORE_MAX_BYTES=2147483648
# YFEIEYE_RECORD_EXPORT_TEMP_DIR=/data/yfeieye-record-exports/tmp
# YFEIEYE_RECORD_EXPORT_TEMP_MAX_BYTES=1073741824
# YFEIEYE_RECORD_EXPORT_ORPHAN_TTL_SECONDS=3600
# YFEIEYE_FFMPEG_MAX_CONCURRENT=1
# YFEIEYE_FFMPEG_SLOT_WAIT_SECONDS=30
# YFEIEYE_FFMPEG_THREADS=1
# YFEIEYE_FFMPEG_FILTER_THREADS=1
# YFEIEYE_FFMPEG_TIMEOUT_BASE_SECONDS=30
# YFEIEYE_FFMPEG_TIMEOUT_PER_MEDIA_SECOND=4
# YFEIEYE_FFMPEG_TIMEOUT_MAX_SECONDS=600
# YFEIEYE_MEDIA_DISK_MIN_FREE_BYTES=2147483648
# YFEIEYE_RECORD_CACHE_EVENT_DIR=/data/yfeieye-record-exports/record-cache-events
# YFEIEYE_RECORD_CACHE_EVENT_RETENTION_HOURS=168
# YFEIEYE_RECORD_CACHE_EVENT_MAX_FILES=10000
# YFEIEYE_RECORD_DRIFT_LOOKBACK_HOURS=720
# YFEIEYE_SEEKABLE_PLAYBACK_CACHE_DIR=/data/yfeieye-record-exports/seekable-playback
# YFEIEYE_SEEKABLE_PLAYBACK_CACHE_TTL_SECONDS=86400
# YFEIEYE_SEEKABLE_PLAYBACK_CACHE_MAX_BYTES=2147483648
# YFEIEYE_SEEKABLE_PLAYBACK_LOCK_STALE_SECONDS=60
# YFEIEYE_SEEKABLE_PLAYBACK_LOCK_HEARTBEAT_SECONDS=5
# YFEIEYE_SEEKABLE_PLAYBACK_READ_LEASE_STALE_SECONDS=86400
# YFEIEYE_SEEKABLE_PLAYBACK_MAX_OUTPUT_BYTES=1073741824
# YFEIEYE_VIDEO_SCHEMA_LOCK_WAIT_SECONDS=60
# YFEIEYE_VIDEO_SCHEMA_STATEMENT_TIMEOUT_MS=300000
# YFEIEYE_VIDEO_SCHEMA_DB_LOCK_TIMEOUT_MS=10000
# YFEIEYE_RECORD_EXPORT_STORAGE_TYPE=minio
# YFEIEYE_RECORD_EXPORT_STORAGE_URI=s3://review-evidence/record-exports
# YFEIEYE_RECORD_EXPORT_RETENTION_DAYS=7
# YFEIEYE_RECORD_EXPORT_MAX_SEGMENTS=16
# YFEIEYE_RECORD_EXPORT_MAX_TOTAL_DURATION_SECONDS=3600
# YFEIEYE_RECORD_EXPORT_MAX_INPUT_BYTES=2147483648
# YFEIEYE_RECORD_EXPORT_MAX_OUTPUT_BYTES=2147483648
# YFEIEYE_RECORD_EXPORT_S3_ENDPOINT=127.0.0.1:9000
# YFEIEYE_RECORD_EXPORT_S3_ACCESS_KEY=minio-access-key
# YFEIEYE_RECORD_EXPORT_S3_SECRET_KEY=minio-secret-key
# YFEIEYE_RECORD_EXPORT_S3_SECURE=false
# YFEIEYE_RECORD_EXPORT_FFMPEG_MODE=browser_compatible
# NODE_REMOTE_DEPLOY=false       # mini 无 iot-node，须为 false

# ============================================
# 推流转发集群调度（iot-node 远程部署）
# ============================================
# 启用远程节点部署（iot-node 会在 deploy 前经 SSH 自动同步 VIDEO 代码到节点）
# NODE_REMOTE_DEPLOY=true
# NODE_REMOTE_VIDEO_ROOT=/opt/easyaiot/VIDEO
# NODE_REMOTE_PYTHON=python3
# NODE_REMOTE_FFMPEG_ROOT=/opt/easyaiot/tools/ffmpeg
# FFMPEG_PATH=/opt/easyaiot/tools/ffmpeg/bin/ffmpeg
#
# NVR 多路自动任务默认调度策略（单路仍为 local）
# STREAM_FORWARD_NVR_SCHEDULE_POLICY=auto
# 是否将历史 NVR local 任务自动升级为 auto
# STREAM_FORWARD_NVR_UPGRADE_LOCAL=true
# 手动创建的多路任务默认策略（未指定时）
# STREAM_FORWARD_MULTI_DEVICE_SCHEDULE_POLICY=local
# 多路远程任务是否按设备/分片拆分 workload
# STREAM_FORWARD_DEVICE_LEVEL_SCHEDULE=true
# 每个远程分片包含的摄像头数量（默认 4，同进程 FFmpeg 多路复用）
# STREAM_FORWARD_DEVICES_PER_SHARD=4
# FFmpeg 原生推流：逐路独立 RTSP→RTMP（默认 true，故障隔离 + 自动重启）
# STREAM_FORWARD_FFMPEG_NATIVE=true
# 单进程多路复用（不推荐：任一路 Broken pipe 会拖垮全部路，仅调试时可开）
# STREAM_FORWARD_FFMPEG_MUX=false
# 逐路中继重启退避（秒）
# STREAM_FORWARD_RELAY_RESTART_DELAY_SEC=3
# STREAM_FORWARD_RELAY_RESTART_COOLDOWN_SEC=10
# STREAM_FORWARD_RELAY_MAX_BACKOFF_SEC=60
# 多路并发 demux 队列深度（每路 FFmpeg 进程独立；2 路及以上默认 512；100 路部署请设 TARGET_STREAMS=100）
# STREAM_FORWARD_TARGET_STREAMS=100
# STREAM_FORWARD_THREAD_QUEUE_SIZE=512
# STREAM_FORWARD_MAX_MUXING_QUEUE_SIZE=2048
# 远程分片部署失败时回退本机（单节点或未配置 SSH/Agent 时建议保持 true）
# STREAM_FORWARD_REMOTE_FALLBACK_LOCAL=true
# auto 调度时是否将少量分片留在本机（默认 true，配合 LOCAL_MAX_SHARDS 限制本机占比）
# STREAM_FORWARD_AUTO_INCLUDE_LOCAL=true
# auto 调度时控制面本机最多承载的分片数（0=完全远程，1=最少占比，默认 1）
# STREAM_FORWARD_LOCAL_MAX_SHARDS=1
# auto 调度批量部署时尽量将分片轮询分散到不同节点（默认 true）
# STREAM_FORWARD_SPREAD_SHARDS=true
# 说明：重启/全量部署时会先释放 node_workload_binding 并禁用 sticky，避免调度器沿用旧占用
# 远程推流前自动检测并拉起目标节点 SRS（解决分屏远程流 SRS 为空，默认 true）
# STREAM_FORWARD_ENSURE_SRS=true
# 是否硬排除控制面节点（默认 false，由 iot-node 调度 score 降权；true 则完全不下本机）
# STREAM_FORWARD_EXCLUDE_PLATFORM=false
# HEVC/非 H.264 转码推流参数（勿回落 FFMPEG_VIDEO_BITRATE，避免多路 3500k 打满 CPU）
# STREAM_FORWARD_TRANSCODE_BITRATE=1200k
# STREAM_FORWARD_TRANSCODE_PRESET=ultrafast
# STREAM_FORWARD_TRANSCODE_FPS=12
# STREAM_FORWARD_TRANSCODE_SCALE=960:540
# STREAM_FORWARD_TRANSCODE_THREADS=2
# STREAM_FORWARD_TRANSCODE_GOP=30
#
# ---- 算法任务集群分片（对齐推流转发；realtime/snap/patrol + auto/node + 多路）----
# ALGORITHM_DEVICE_LEVEL_SCHEDULE=true
# realtime 每个分片设备数（cpp 建议 1：一路一 RUNTIME / 一 workload）
# ALGORITHM_DEVICES_PER_SHARD=1
# snap/patrol 每个分片设备数（分片内单进程多设备；未设则默认 4）
# ALGORITHM_SNAP_DEVICES_PER_SHARD=4
# ALGORITHM_SPREAD_SHARDS=true
# ALGORITHM_AUTO_INCLUDE_LOCAL=true
# ALGORITHM_LOCAL_MAX_SHARDS=1
# ALGORITHM_REMOTE_FALLBACK_LOCAL=true
# ALGORITHM_EXCLUDE_PLATFORM=false
# ALGORITHM_HEARTBEAT_FAILOVER_SECONDS=90
#
# 健康监控：离线节点分片自动迁移、心跳超时重部署
# STREAM_FORWARD_HEALTH_MONITOR_ENABLED=true
# STREAM_FORWARD_HEALTH_INTERVAL_SECONDS=60
# STREAM_FORWARD_HEARTBEAT_FAILOVER_SECONDS=90
# ============================================
# 大疆司空 FlightHub 直播接入（机场 / 无人机共用）
# ============================================
# 机场与无人机使用同一套开启直播 OpenAPI，仅设备 SN / camera_index 与展示类型不同。
# FLIGHTHUB_OPENAPI_HOST=es-flight-api-cn.djigate.com
# FLIGHTHUB_PLATFORM_HOST=es-flight-api-cn.djigate.com
# FLIGHTHUB_LIVE_START_PATH=/openapi/v0.1/live-stream/start
# FLIGHTHUB_WORKSPACE_ID=
# FLIGHTHUB_WORKSPACE_NAME=
# FLIGHTHUB_PLATFORM_NAME=
# FLIGHTHUB_USER_TOKEN=
# FLIGHTHUB_ALLOWED_IPS=
# MQTT 仅为配置回显占位，视频拉流走 OpenAPI 而非 MQTT
# FLIGHTHUB_MQTT_ENABLED=false
# FLIGHTHUB_MQTT_BROKER_URI=
# FLIGHTHUB_MQTT_CLIENT_ID=
# FLIGHTHUB_MQTT_USERNAME=

# ============================================
# RTC / go2rtc 消费级摄像头桥接
# ============================================
# RTC 管理服务地址（yFeiEye RTC 模块 Flask API）
RTC_SERVICE_URL=http://127.0.0.1:6100
# go2rtc Web UI（浏览器访问，经 nginx 反代；须带尾斜杠避免 301 丢端口）
RTC_GO2RTC_WEB_URL=/dev-api/go2rtc/
# go2rtc RTSP 输出地址（VIDEO 拉流用，host 网络默认同机）
RTC_RTSP_HOST=127.0.0.1
RTC_RTSP_PORT=8554

# ============================================
# RUNTIME 高性能执行器（由 VIDEO/install_linux.sh 自动编译并写入）
# ============================================
# RUNTIME_BIN=/opt/easyaiot/RUNTIME/build/RUNTIME
# LD_LIBRARY_PATH=/opt/easyaiot/runtime-conda-lib:/opt/easyaiot/ort-lib
# RUNTIME_HOST_DIR=/path/to/easyaiot/RUNTIME
# RUNTIME_CONDA_LIB_HOST=/path/to/conda/envs/easyaiot-runtime/lib
# RUNTIME_ORT_LIB_HOST=/path/to/.deps/onnxruntime-linux-x64-1.23.2/lib
