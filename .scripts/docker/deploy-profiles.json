{
  "schemaVersion": 1,
  "defaultProfile": "full",
  "networkName": "yfeieye-network",
  "profileOrder": ["edge", "mini", "standard", "full"],
  "moduleOrder": [
    ".scripts/docker",
    "DEVICE",
    "AI",
    "RTC",
    "POST",
    "VIDEO",
    "WEB",
    "APP",
    "VISUALIZE",
    "TRANSFORM",
    "HARNESS",
    "IDEA",
    "TERMINAL",
    "TWIN",
    "PANEL"
  ],
  "moduleEnvironmentOverrides": {
    "HARNESS": "EASYAIOT_ENABLE_HARNESS",
    "IDEA": "EASYAIOT_ENABLE_IDEA",
    "TERMINAL": "EASYAIOT_ENABLE_TERMINAL",
    "TWIN": "EASYAIOT_ENABLE_TWIN",
    "PANEL": "EASYAIOT_ENABLE_PANEL"
  },
  "externalModules": {
    "HARNESS": { "repository": "https://github.com/xinlingzhifei-sh/yfeieye-harness.git", "ref": "main" },
    "IDEA": { "repository": "https://github.com/xinlingzhifei-sh/yfeieye-idea.git", "ref": "main" },
    "TERMINAL": { "repository": "https://github.com/xinlingzhifei-sh/yfeieye-terminal.git", "ref": "main" },
    "TWIN": { "repository": "https://github.com/xinlingzhifei-sh/yfeieye-twin.git", "ref": "main" },
    "SITE": { "repository": "https://github.com/xinlingzhifei-sh/yfeieye-site.git", "ref": "main" }
  },
  "featureOrder": ["mqtt-demo", "industrial-demo", "flow-demo"],
  "featureEnvironmentOverrides": {
    "mqtt-demo": "EASYAIOT_ENABLE_MQTT_DEMO",
    "industrial-demo": "EASYAIOT_ENABLE_INDUSTRIAL_DEMO",
    "flow-demo": "EASYAIOT_ENABLE_FLOW_DEMO"
  },
  "middlewareServiceOrder": [
    "Nacos",
    "PostgresSQL-init",
    "PostgresSQL",
    "TDengine",
    "TDengine-init",
    "Redis",
    "Kafka",
    "MinIO",
    "Milvus",
    "SRS",
    "NodeRED",
    "FUXA",
    "EMQX",
    "ZLMediaKit",
    "GPUStack"
  ],
  "middlewareEnvironmentOverrides": {
    "GPUStack": "EASYAIOT_ENABLE_GPUSTACK"
  },
  "deviceServiceOrder": [
    "iot-gateway",
    "iot-system",
    "iot-infra",
    "iot-device",
    "iot-dataset",
    "iot-node",
    "iot-visualize",
    "iot-flow",
    "iot-tdengine",
    "iot-file",
    "iot-message",
    "iot-sink",
    "iot-gb28181"
  ],
  "containerNames": {
    "middleware": {
      "Nacos": ["nacos-server"],
      "PostgresSQL-init": ["postgres-init"],
      "PostgresSQL": ["postgres-server"],
      "TDengine": ["tdengine-server"],
      "TDengine-init": ["tdengine-init"],
      "Redis": ["redis-server"],
      "Kafka": ["kafka-server"],
      "MinIO": ["minio-server"],
      "Milvus": ["milvus-server"],
      "SRS": ["srs-server"],
      "NodeRED": ["nodered-server"],
      "FUXA": ["fuxa-server"],
      "EMQX": ["emqx-server"],
      "ZLMediaKit": ["zlmediakit-server"],
      "GPUStack": ["gpustack-server", "gpustack-worker"]
    },
    "modules": {
      "AI": ["ai-service"],
      "RTC": ["rtc-service"],
      "POST": ["post-service"],
      "VIDEO": ["video-service", "pusher-service", "sorter-service", "frame-extractor-service"],
      "WEB": ["web-service"],
      "APP": ["app-service"],
      "VISUALIZE": ["visualize-service"],
      "TRANSFORM": ["transform-service"],
      "HARNESS": ["easyaiot-harness"],
      "IDEA": ["easyaiot-idea-portal"],
      "TERMINAL": ["easyaiot-terminal"],
      "TWIN": ["twin-service"],
      "PANEL": ["easyaiot-panel"]
    }
  },
  "profiles": {
    "edge": {
      "aliases": ["0", "pure-edge", "standalone-edge"],
      "label": "edge（纯边缘形态，推荐 >= 2 GB）",
      "containerMemoryBudgetMiB": 2048,
      "budgetLabel": "2 GB",
      "dockerDesktop": { "memoryGiB": 2, "cpus": 2, "diskGiB": 40 },
      "frontendProfile": "mini",
      "localStorage": true,
      "modules": [".scripts/docker", "VIDEO", "WEB"],
      "middlewareServices": ["PostgresSQL-init", "PostgresSQL", "Redis", "SRS"],
      "deviceServices": [],
      "features": [],
      "capabilities": ["ai.inference"]
    },
    "mini": {
      "aliases": ["1", "minimal", "4g"],
      "label": "mini（边缘精简版，推荐 >= 4 GB）",
      "containerMemoryBudgetMiB": 4096,
      "budgetLabel": "4 GB",
      "dockerDesktop": { "memoryGiB": 4, "cpus": 4, "diskGiB": 60 },
      "frontendProfile": "mini",
      "localStorage": true,
      "modules": [".scripts/docker", "DEVICE", "AI", "VIDEO", "WEB"],
      "middlewareServices": ["Nacos", "PostgresSQL-init", "PostgresSQL", "Redis", "Kafka", "MinIO", "SRS", "EMQX"],
      "deviceServices": ["iot-gateway", "iot-system", "iot-infra", "iot-sink"],
      "features": [],
      "capabilities": ["ai.inference", "media.nfs-cluster"]
    },
    "standard": {
      "aliases": ["2", "std", "16g"],
      "label": "standard（标准版，推荐 >= 16 GB）",
      "containerMemoryBudgetMiB": 16384,
      "budgetLabel": "16 GB",
      "dockerDesktop": { "memoryGiB": 16, "cpus": 6, "diskGiB": 80 },
      "frontendProfile": "standard",
      "localStorage": false,
      "modules": [".scripts/docker", "DEVICE", "AI", "RTC", "POST", "VIDEO", "WEB"],
      "middlewareServices": ["Nacos", "PostgresSQL-init", "PostgresSQL", "Redis", "Kafka", "MinIO", "Milvus", "SRS", "EMQX", "ZLMediaKit"],
      "deviceServices": ["iot-gateway", "iot-system", "iot-infra", "iot-dataset", "iot-node", "iot-flow", "iot-file", "iot-message", "iot-sink", "iot-gb28181"],
      "features": [],
      "capabilities": [
        "ai.inference",
        "ai.training",
        "video.gb28181",
        "video.rtc",
        "video.identity-library",
        "video.dji",
        "media.nfs-cluster",
        "workflow.flow",
        "node.cluster",
        "dataset.annotation",
        "notification.management",
        "infra.management",
        "alert.map"
      ]
    },
    "full": {
      "aliases": ["3", "complete", "20g"],
      "label": "full（完整生产版，推荐 >= 20 GB）",
      "containerMemoryBudgetMiB": 20480,
      "budgetLabel": "20 GB",
      "dockerDesktop": { "memoryGiB": 20, "cpus": 8, "diskGiB": 100 },
      "frontendProfile": "full",
      "localStorage": false,
      "modules": [".scripts/docker", "DEVICE", "AI", "RTC", "POST", "VIDEO", "WEB", "APP", "VISUALIZE", "TRANSFORM"],
      "middlewareServices": ["Nacos", "PostgresSQL-init", "PostgresSQL", "TDengine", "TDengine-init", "Redis", "Kafka", "MinIO", "Milvus", "SRS", "NodeRED", "FUXA", "EMQX", "ZLMediaKit"],
      "deviceServices": ["iot-gateway", "iot-system", "iot-infra", "iot-device", "iot-dataset", "iot-node", "iot-visualize", "iot-flow", "iot-tdengine", "iot-file", "iot-message", "iot-sink", "iot-gb28181"],
      "features": [],
      "capabilities": [
        "ai.inference",
        "ai.training",
        "video.gb28181",
        "video.rtc",
        "video.identity-library",
        "video.dji",
        "media.nfs-cluster",
        "workflow.flow",
        "node.cluster",
        "device.management",
        "product.management",
        "ota.management",
        "dataset.annotation",
        "rule.engine",
        "notification.management",
        "infra.management",
        "visualize",
        "transform",
        "alert.map"
      ]
    }
  },
  "web": {
    "menuAliases": [
      { "capabilityId": "workflow.flow", "routeNames": ["Flow"], "componentNames": [], "pathPrefixes": ["/flow"], "legacyTitles": ["告警工单"] },
      { "capabilityId": "node.cluster", "routeNames": ["NodeManage", "ComputeNodeManage", "ComputeNodeIndex"], "componentNames": ["NodeManage", "ComputeNodeManage", "ComputeNodeIndex"], "pathPrefixes": ["/node"], "legacyTitles": ["集群管理"] },
      { "capabilityId": "device.management", "routeNames": ["Devices"], "componentNames": ["Devices"], "pathPrefixes": ["/device"], "legacyTitles": ["设备管理"] },
      { "capabilityId": "product.management", "routeNames": ["Product"], "componentNames": ["Product"], "pathPrefixes": ["/product"], "legacyTitles": ["产品管理"] },
      { "capabilityId": "ota.management", "routeNames": ["OtaVersion"], "componentNames": ["OtaVersion"], "pathPrefixes": ["/ota"], "legacyTitles": ["OTA升级"] },
      { "capabilityId": "dataset.annotation", "routeNames": ["Dataset"], "componentNames": ["Dataset"], "pathPrefixes": ["/dataset"], "legacyTitles": ["数据标注"] },
      { "capabilityId": "rule.engine", "routeNames": ["RuleChains"], "componentNames": ["RuleChains"], "pathPrefixes": ["/rulechains", "/rulechain-editor"], "legacyTitles": ["规则引擎"] },
      { "capabilityId": "notification.management", "routeNames": ["Notice"], "componentNames": ["Notice"], "pathPrefixes": ["/notice"], "legacyTitles": ["通知管理"] },
      { "capabilityId": "infra.management", "routeNames": ["Infra"], "componentNames": ["Infra"], "pathPrefixes": ["/infra"], "legacyTitles": ["基础设施"] },
      { "capabilityId": "visualize", "routeNames": ["Visualize", "View"], "componentNames": ["Visualize", "View"], "pathPrefixes": ["/visualize", "/view"], "legacyTitles": ["可视化管理", "大屏管理", "可视化大屏"] },
      { "capabilityId": "transform", "routeNames": ["TransformManage", "Transform"], "componentNames": ["TransformManage", "Transform"], "pathPrefixes": ["/transform"], "legacyTitles": ["系统对接", "数据转发"] },
      { "capabilityId": "assistant.harness", "routeNames": ["HarnessManage", "HarnessPortal"], "componentNames": ["HarnessManage", "HarnessPortal"], "pathPrefixes": ["/harness"], "legacyTitles": ["HARNESS AI助手"] }
    ]
  }
}
