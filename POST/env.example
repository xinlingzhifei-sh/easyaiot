# ============================================
# yFeiEye POST 定制后处理模块环境变量
# 复制为 .env.docker / .env 后按需修改（install_linux.sh 首次安装会自动复制并同步中间件凭据）
# ============================================

# MQTT（host 网络默认连宿主机 EMQX）
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=post
MQTT_SHARE_GROUP=post

# Topics
TOPIC_INFER_EVENT=mqtt/iot-infer-event
TOPIC_LEGACY_ALERT=mqtt/iot-alert-notification
TOPIC_SNAPSHOT_ALERT=mqtt/iot-snapshot-alert
TOPIC_ALERT_FINAL=mqtt/iot-alert-final
TOPIC_TASK_SYNC=mqtt/iot-post-task-sync
TOPIC_POST_TRACE=mqtt/iot-post-trace
POST_PUBLISH_OPTIONAL_FINAL=false

# 暖库只读（algorithm_task 在 VIDEO 库）；空则依赖 VIDEO PUT 下发
# 口令填中间件 .scripts/docker/.env.docker 中的 POSTGRES_PASSWORD（含 @ : / 等字符时需百分号编码）；
# install_linux.sh 会把 CHANGE_ME 占位自动替换为中间件实际口令，缺失则安装失败
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/iot-video20?sslmode=disable

# HTTP 管理 / metrics
POST_HTTP_ADDR=:8089
POST_HOST_PORT=8089
POST_ADMIN_TOKEN=
POST_DEBUG=false
POST_DEBUG_HTTP=true
POST_ENABLED=true
POST_INSTANCE_ID=

# 任务模板缓存
TASK_CACHE_TTL_SEC=300

# Nacos 注册（非空则 ready 后注册；与 VIDEO 发现一致）
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=
# Nacos 账号与中间件 .scripts/docker/.env.docker 的 NACOS_USERNAME / NACOS_PASSWORD 一致；
# 保持 CHANGE_ME 时 install_linux.sh 会从中间件配置同步
NACOS_USERNAME=CHANGE_ME
NACOS_PASSWORD=CHANGE_ME
POST_NACOS_SERVICE=easyaiot-post

# 外置插件 / user_script
PLUGIN_HTTP_TIMEOUT_MS=2000
USER_SCRIPT_URL=

# 时区
TZ=Asia/Shanghai
